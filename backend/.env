# ==============================================================================
# CaféTrace SV — Entorno de Configuración (Backend)
# ==============================================================================

# --- Configuración General ---
PROJECT_NAME="CaféTrace SV Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# --- Base de Datos PostgreSQL / PostGIS ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cafetrace_user
POSTGRES_PASSWORD=cafetrace_secure_password_2026
POSTGRES_DB=cafetrace_db

# --- Seguridad y Autenticación JWT ---
# En producción, genera una clave segura: openssl rand -hex 32
SECRET_KEY=cafetrace_super_secret_jwt_key_for_development_purposes_only_change_in_prod_2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Configuración CORS ---
# Lista en formato JSON o separada por comas
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Configuración de la API de Global Forest Watch ---
GFW_API_KEY=d1f99e19-235d-433c-a201-5f3c311de51e
